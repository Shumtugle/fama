<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.shumtugle.fama"
    android:versionCode="300"
    android:versionName="0.3.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />

    <!-- The board reads public pages of channels, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Ground">
        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- What is shared to the board: a channel's link or an announcement's
             words. The sheet rises over whatever shared it, stays out of the
             list of recent screens, and leaves nothing behind when it goes. -->
        <activity
            android:name=".Take"
            android:exported="true"
            android:theme="@style/Veil"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
